NODE_ENV=development
PORT=3001

# AWS Region (use ap-south-1 for Mumbai)
AWS_REGION=ap-south-1

# Local DynamoDB credentials (any value works for local)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Local DynamoDB endpoint — leave empty in production (Lambda uses real AWS)
DYNAMODB_ENDPOINT=http://localhost:8000

# Table names — local uses -local suffix; production uses -stage or -prod suffix
DYNAMODB_SUBMISSIONS_TABLE=hotel-submissions-local
DYNAMODB_PERSONS_TABLE=hotel-persons-local

# JWT secret — in production this is loaded from SSM Parameter Store, not this file
JWT_SECRET=change-me-in-prod

# Admin credentials — in production loaded from SSM, not this file
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Generate hash: cd backend && node scripts/seedAdmin.js
ADMIN_PASSWORD_HASH=

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:5173

# Deployment environment — controls which SSM path is used in Lambda (/hotel/stage/* or /hotel/prod/*)
# Only relevant when NODE_ENV is NOT 'development'
# DEPLOY_ENV=stage
